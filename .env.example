# Copy this file to .env for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit .env or paste these values into the game's code.

# Neon connection strings: Neon dashboard → your project → Connect. Both start with
# postgresql:// . The pooled one (host contains "-pooler") is used by the API when set;
# the direct one is used by `npm run db:setup` to create the tables.
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Auth (player accounts): Neon dashboard → Auth → copy the Auth URL
# (it ends with /neondb/auth). Players sign in through this site, never directly.
NEON_AUTH_BASE_URL=

# A long random secret used to anonymize player IP addresses for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
